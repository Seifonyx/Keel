<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- KEEL: Keel's app icons. The asset names (Dark, Sandy, Blue, Snow) are upstream's slots, reused for Keel colourways. -->
<plist version="1.0">
<dict>
	<key>classic</key>
	<array>
		<dict>
			<key>name</key>
			<string>Keel</string>
			<key>imageName</key>
			<string>App</string>
			<key>iconName</key>
			<string>AppIcon</string>
		</dict>
	</array>
	<key>modern</key>
	<array>
		<dict>
			<key>name</key>
			<string>Ink</string>
			<key>imageName</key>
			<string>Dark</string>
			<key>iconName</key>
			<string>DarkIcon</string>
		</dict>
		<dict>
			<key>name</key>
			<string>Terracotta</string>
			<key>imageName</key>
			<string>Sandy</string>
			<key>iconName</key>
			<string>SandyIcon</string>
		</dict>
		<dict>
			<key>name</key>
			<string>Sea</string>
			<key>imageName</key>
			<string>Blue</string>
			<key>iconName</key>
			<string>BlueIcon</string>
		</dict>
		<dict>
			<key>name</key>
			<string>Paper</string>
			<key>imageName</key>
			<string>Snow</string>
			<key>iconName</key>
			<string>SnowIcon</string>
		</dict>
	</array>
</dict>
</plist>
